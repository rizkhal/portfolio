---
const facts = [
  { term: 'now', value: 'Inertable, Picly' },
  { term: 'repos', value: '101 public' },
  { term: 'since', value: '2016' },
]
---

<section id="top" class="wrap pt-20 pb-16 md:pt-24 md:pb-24">
  <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <p class="label">Software engineer</p>

      <h1 class="mt-5 text-4xl leading-[1.05] tracking-tight md:text-5xl lg:text-6xl">
        Software for messy, real-world data.
      </h1>

      <p class="mt-6 max-w-[46ch] text-base leading-relaxed text-muted md:text-lg">
        TypeScript, Python, and PHP. Desktop apps, developer tooling, and the plumbing in between.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="#work"
          class="inline-flex items-center gap-2 bg-accent px-5 py-3 font-mono text-xs uppercase tracking-[0.12em] text-[#0a0a0b] transition-transform duration-200 hover:-translate-y-px active:translate-y-0 active:scale-[0.99]"
        >
          See the work
        </a>
        <a
          href="https://github.com/rizkhal"
          class="inline-flex items-center gap-2 border border-line-strong px-5 py-3 font-mono text-xs uppercase tracking-[0.12em] text-text transition-colors hover:border-accent hover:text-accent"
          rel="me noopener"
          target="_blank"
        >
          GitHub
        </a>
      </div>
    </div>

    <div class="lg:col-span-5 lg:pl-10">
      <div class="flex items-start gap-5">
        <img
          src="/avatar.png"
          alt="Rizkal"
          width="132"
          height="132"
          class="h-[132px] w-[132px] shrink-0 border border-line object-cover"
          loading="eager"
          decoding="async"
        />

        <dl class="grid gap-3 pt-1 font-mono text-xs">
          {facts.map((fact) => (
            <div class="grid gap-0.5">
              <dt class="text-faint uppercase tracking-[0.14em]">{fact.term}</dt>
              <dd class="text-text">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
