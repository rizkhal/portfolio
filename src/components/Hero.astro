---
const facts = [
  { term: 'now', value: 'Pedoman, OCEANGAZE' },
  { term: 'repos', value: '100 public' },
  { term: 'since', value: '2016' },
]
---

<section id="top" class="relative">
  <div
    class="wrap grid items-center gap-12 py-10 md:py-14 lg:min-h-[calc(100dvh-4rem)] lg:grid-cols-12 lg:gap-10"
  >
    <div class="lg:col-span-7">
      <p class="label hero-in" style="animation-delay:60ms">Portfolio / 2026</p>

      <h1 class="display hero-in mt-6 text-[clamp(2.6rem,6.4vw,5.2rem)]" style="animation-delay:140ms">
        Software for <em>messy</em>, real-world data.
      </h1>

      <div class="horizon-rule hero-in mt-9 max-w-[32rem]" style="animation-delay:320ms"></div>

      <p class="hero-in mt-7 max-w-[44ch] text-base leading-relaxed text-mist md:text-lg" style="animation-delay:420ms">
        TypeScript and Python. Legal corpora, vessel tracking, satellite imagery, and the plumbing in
        between.
      </p>

      <div class="hero-in mt-10 flex flex-wrap items-center gap-3" style="animation-delay:520ms">
        <a
          href="#work"
          class="group inline-flex items-center gap-2.5 bg-sun px-6 py-3.5 font-mono text-[11px] uppercase tracking-[0.16em] text-ink transition-all duration-300 hover:shadow-[0_0_40px_-6px_rgba(255,138,92,0.7)]"
        >
          See the work
          <span class="transition-transform duration-300 group-hover:translate-x-1">-&gt;</span>
        </a>
        <a
          href="https://github.com/rizkhal"
          target="_blank"
          rel="noopener me"
          class="inline-flex items-center border border-ochre/30 px-6 py-3.5 font-mono text-[11px] uppercase tracking-[0.16em] text-ochre transition-colors hover:border-sun hover:text-sun"
        >
          GitHub
        </a>
      </div>
    </div>

    <div class="lg:col-span-5 lg:pl-8">
      <div class="hero-in mx-auto w-[58%] max-w-[15.5rem] sm:w-[44%] lg:mx-0 lg:w-[70%]" style="animation-delay:260ms">
        <div class="door">
          <div class="door__inner">
            <img src="/avatar.png" alt="Rizkal" width="420" height="420" loading="eager" decoding="async" />
          </div>
          <div class="door__spill"></div>
        </div>
        <p class="mt-4 text-center font-mono text-[10px] uppercase tracking-[0.18em] text-ochre/75 lg:text-left">
          self-portrait, 2026
        </p>
      </div>

      <dl class="mt-8 grid gap-2.5 border-t border-ochre/15 pt-5 font-mono text-[11px]">
        {
          facts.map((fact) => (
            <div class="flex items-baseline justify-between gap-4">
              <dt class="uppercase tracking-[0.16em] text-ochre/75">{fact.term}</dt>
              <dd class="text-paper">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
