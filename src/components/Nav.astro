---
const links = [
  { href: '#work', label: 'Work' },
  { href: '#stack', label: 'Stack' },
  { href: '#about', label: 'About' },
]
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-md">
  <div class="wrap flex h-16 items-center justify-between">
    <a href="#top" class="font-mono text-sm tracking-tight text-text">
      rizkal<span class="text-accent">.</span>wtf
    </a>

    <nav class="flex items-center gap-6" aria-label="Sections">
      {links.map((link) => (
        <a
          href={link.href}
          class="link-underline font-mono text-xs uppercase tracking-[0.12em] text-muted transition-colors hover:text-text"
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://github.com/rizkhal"
        class="hidden border border-line-strong px-3 py-1.5 font-mono text-xs uppercase tracking-[0.12em] text-text transition-colors hover:border-accent hover:text-accent sm:inline-block"
        rel="me noopener"
        target="_blank"
      >
        GitHub
      </a>
    </nav>
  </div>
</header>
