---
const links = [
  { href: '#work', label: 'Work' },
  { href: '#stack', label: 'Stack' },
  { href: '#about', label: 'About' },
]
---

<header class="sticky top-0 z-40 bg-gradient-to-b from-ink/85 via-ink/55 to-transparent backdrop-blur-[2px]">
  <div class="wrap flex h-16 items-center justify-between">
    <a href="#top" class="group flex items-center gap-2.5">
      <span
        class="h-2 w-2 rounded-full bg-sun shadow-[0_0_12px_2px_rgba(255,138,92,0.6)] transition-transform duration-500 group-hover:scale-125"
      ></span>
      <span class="font-mono text-xs tracking-[0.16em] text-paper uppercase">rizkal.wtf</span>
    </a>

    <nav aria-label="Sections" class="flex items-center gap-5 md:gap-7">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="link-underline font-mono text-[11px] uppercase tracking-[0.14em] text-mist transition-colors hover:text-paper"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="https://github.com/rizkhal"
        target="_blank"
        rel="noopener me"
        class="hidden border border-ochre/25 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.14em] text-ochre transition-colors hover:border-sun hover:text-sun sm:inline-block"
      >
        GitHub
      </a>
    </nav>
  </div>
</header>
