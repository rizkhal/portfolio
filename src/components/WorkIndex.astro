---
import { featured } from '../data/projects'
---

<section id="work" class="wrap py-20 md:py-28">
  <div class="flex items-end justify-between gap-6">
    <h2 class="display text-[clamp(2rem,4.4vw,3.4rem)]">Selected work</h2>
    <p class="hidden font-mono text-[11px] uppercase tracking-[0.16em] text-ochre/75 sm:block">
      six of one hundred
    </p>
  </div>

  <div class="mt-12 grid gap-6 md:grid-cols-2 md:gap-7">
    {
      featured.map((project, index) => (
        <a
          href={project.href}
          target="_blank"
          rel="noopener"
          data-tilt
          class="float-card reveal group flex flex-col p-7 md:p-8"
          style={`--reveal-delay: ${(index % 2) * 90}ms`}
        >
          <div class="flex items-start justify-between gap-4">
            <span class="ghost-num">{String(index + 1).padStart(2, '0')}</span>
            <span class="mt-1 font-mono text-[11px] tracking-[0.14em] text-ochre/75">
              {project.year}
            </span>
          </div>

          <h3 class="mt-6 text-2xl tracking-tight text-paper transition-colors duration-300 group-hover:text-sun md:text-[1.75rem]">
            {project.name}
          </h3>

          <p class="mt-3 max-w-[46ch] text-sm leading-relaxed text-mist">{project.summary}</p>

          <div class="mt-6 flex items-end justify-between gap-4 pt-1">
            <ul class="flex flex-wrap gap-1.5">
              {project.stack.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
            <span
              aria-hidden="true"
              class="font-mono text-sm text-ochre/65 transition-all duration-300 group-hover:translate-x-1 group-hover:text-sun"
            >
              -&gt;
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>
