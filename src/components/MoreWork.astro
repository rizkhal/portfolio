---
import { more } from '../data/projects'
---

<section class="wrap py-16 md:py-24">
  <h2 class="text-2xl tracking-tight md:text-3xl">Also shipped</h2>

  <ul class="mt-10 grid gap-x-10 md:grid-cols-2">
    {
      more.map((project, index) => (
        <li class="reveal border-t border-line" style={`--reveal-delay: ${(index % 2) * 60}ms`}>
          <a
            href={project.href}
            target="_blank"
            rel="noopener"
            class="group flex h-full flex-col gap-2 py-6"
          >
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-base tracking-tight transition-colors group-hover:text-accent">
                {project.name}
              </h3>
              <span class="font-mono text-xs text-faint">{project.year}</span>
            </div>
            <p class="max-w-[52ch] text-sm leading-relaxed text-muted">{project.summary}</p>
            <p class="mt-auto pt-1 font-mono text-[11px] uppercase tracking-[0.1em] text-faint">
              {project.stack.join(' / ')}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</section>
