---
import { more } from '../data/projects'
---

<section class="wrap py-20 md:py-28">
  <h2 class="display text-[clamp(2rem,4.4vw,3.4rem)]">Also shipped</h2>

  <ul class="mt-12 grid gap-x-12 md:grid-cols-2">
    {
      more.map((project, index) => (
        <li class="reveal border-t border-ochre/15" style={`--reveal-delay: ${(index % 2) * 70}ms`}>
          <a
            href={project.href}
            target="_blank"
            rel="noopener"
            class="group flex h-full flex-col gap-2 py-6"
          >
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-lg tracking-tight text-paper transition-colors duration-300 group-hover:text-sun">
                {project.name}
              </h3>
              <span class="font-mono text-[11px] text-ochre/65">{project.year}</span>
            </div>
            <p class="max-w-[50ch] text-sm leading-relaxed text-mist">{project.summary}</p>
            <p class="mt-auto pt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-ochre/60">
              {project.stack.join(' / ')}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</section>
