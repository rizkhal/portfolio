---
import { stackGroups } from '../data/projects'
---

<section id="stack" class="wrap py-20 md:py-28">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4">
      <h2 class="display text-[clamp(2rem,4.4vw,3.4rem)]">What I reach for</h2>
      <p class="mt-5 max-w-[34ch] text-sm leading-relaxed text-mist">
        Boring tools, chosen on purpose. Everything here I have run in production, not just read
        about.
      </p>
    </div>

    <div class="grid gap-x-12 gap-y-9 sm:grid-cols-2 lg:col-span-8">
      {
        stackGroups.map((group, index) => (
          <div class="reveal" style={`--reveal-delay: ${(index % 2) * 70}ms`}>
            <h3 class="font-mono text-[10px] uppercase tracking-[0.18em] text-ochre/75">
              {group.title}
            </h3>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
