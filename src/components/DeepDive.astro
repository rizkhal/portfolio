---
const metrics = [
  { value: '685', unit: 'installs', label: 'Packagist downloads for rizkhal/inertable since release' },
  { value: '15', unit: 'stars', label: 'GitHub stars, with two forks carrying their own changes' },
  { value: '2', unit: 'CI jobs', label: 'Test suite and php-cs-fixer, both green on every push' },
  { value: '8.0', unit: 'PHP', label: 'Minimum runtime, no extensions beyond the standard build' },
]
---

<section class="border-y border-line bg-surface">
  <div class="wrap grid gap-12 py-16 md:py-24 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <h2 class="text-2xl tracking-tight md:text-3xl">A package people install, not just a repo</h2>

      <p class="mt-5 max-w-[52ch] text-sm leading-relaxed text-muted md:text-base">
        Inertable is a headless datatable for Laravel and Inertia. Sorting, filtering, and pagination
        are handled on the server; the markup is left entirely to you, so a table can look like
        whatever the page already looks like. It ships on Packagist with a test suite and a style
        check running on every push. Every figure here comes from Packagist and the repository.
      </p>

      <a
        href="https://github.com/rizkhal/inertable"
        target="_blank"
        rel="noopener"
        class="link-underline mt-7 inline-block font-mono text-xs uppercase tracking-[0.12em] text-accent"
      >
        Read the repository
      </a>
    </div>

    <div class="lg:col-span-7">
      <dl class="grid gap-px bg-line sm:grid-cols-2">
        {
          metrics.map((metric) => (
            <div class="bg-surface p-6 md:p-7">
              <dt class="flex items-baseline gap-1.5">
                <span class="font-mono text-3xl tracking-tight text-text md:text-4xl">
                  {metric.value}
                </span>
                <span class="font-mono text-xs text-accent">{metric.unit}</span>
              </dt>
              <dd class="mt-3 max-w-[34ch] text-xs leading-relaxed text-muted">{metric.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
