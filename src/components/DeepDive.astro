---
const metrics = [
  { value: '0.59', unit: 'm/px', label: 'Tile resolution, 529 tiles stitched with zero failures' },
  { value: '13', unit: '/ 0', label: 'Ships found and false positives, YOLOv8s-OBB pass' },
  { value: '0.527', unit: 'mAP', label: 'Water mask fine-tune, YOLO11n-seg over 720 images' },
  { value: '0.20', unit: '%', label: 'Worst area error against five real permit documents' },
]
---

<section class="border-y border-line bg-surface">
  <div class="wrap grid gap-12 py-16 md:py-24 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <h2 class="text-2xl tracking-tight md:text-3xl">Coastal detection, checked against real documents</h2>

      <p class="mt-5 max-w-[52ch] text-sm leading-relaxed text-muted md:text-base">
        CoastDet reads sub-meter satellite tiles and finds ships, docks, tanks, ponds, and new
        construction along the shoreline. It also compares two epochs of the same tile to show what
        changed. Every figure here comes from the repository's own test runs.
      </p>

      <a
        href="https://github.com/rizkhal/tangkap"
        target="_blank"
        rel="noopener"
        class="link-underline mt-7 inline-block font-mono text-xs uppercase tracking-[0.12em] text-accent"
      >
        Read the repository
      </a>
    </div>

    <div class="lg:col-span-7">
      <dl class="grid gap-px bg-line sm:grid-cols-2">
        {
          metrics.map((metric) => (
            <div class="bg-surface p-6 md:p-7">
              <dt class="flex items-baseline gap-1.5">
                <span class="font-mono text-3xl tracking-tight text-text md:text-4xl">
                  {metric.value}
                </span>
                <span class="font-mono text-xs text-accent">{metric.unit}</span>
              </dt>
              <dd class="mt-3 max-w-[34ch] text-xs leading-relaxed text-muted">{metric.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
