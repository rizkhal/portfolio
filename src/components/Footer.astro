---
const year = new Date().getFullYear()
---

<footer id="contact" class="border-t border-line">
  <div class="wrap flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="text-sm text-text">Rizkal</p>
      <p class="mt-1 font-mono text-xs text-muted">Jakarta, Indonesia</p>
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-xs uppercase tracking-[0.12em]">
      <a
        href="https://github.com/rizkhal"
        target="_blank"
        rel="noopener me"
        class="link-underline text-muted transition-colors hover:text-accent">GitHub</a
      >
      <a
        href="https://x.com/rixzkl"
        target="_blank"
        rel="noopener me"
        class="link-underline text-muted transition-colors hover:text-accent">X</a
      >
      <span class="text-faint">{year}</span>
    </div>
  </div>
</footer>
